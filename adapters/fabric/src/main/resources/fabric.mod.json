{
  "schemaVersion": 1,
  "id": "${projectId}",
  "version": "${projectVersion}",
  "name": "${projectName}",
  "description": "Skills and adaptations for survival servers.",
  "authors": ["Volmit Software"],
  "license": "GPL-3.0",
  "environment": "*",
  "entrypoints": {
    "main": ["${projectGroup}.fabric.AdaptFabric"]
  },
  "mixins": ["adapt.mixins.json", "adapt-platform.mixins.json", "adapt.feature.mixins.json", "adapt.gap-block.mixins.json", "adapt.gap-entity.mixins.json"],
  "jars": [
    {"file": "META-INF/jars/fabric-api-base.jar"},
    {"file": "META-INF/jars/fabric-lifecycle-events-v1.jar"},
    {"file": "META-INF/jars/fabric-command-api-v2.jar"}
  ],
  "depends": {
    "fabricloader": ">=${fabricLoaderVersion}",
    "minecraft": "${minecraftVersion}",
    "java": ">=${javaVersion}"
  }
}
